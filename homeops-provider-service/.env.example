# Copy to .env and fill in real values. Never commit .env.
# Use Supabase Session pooler (port 5432) for laptop / IPv4 networks:
# Project → Connect → Session pooler
DATABASE_URL="postgresql://postgres.PROJECT_ID:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Required when creating repair applications. Use a long random value.
APPLICATION_ACTION_SECRET="change-this-to-a-long-random-secret"

# Optional: enables signed events to the separate Telegram agent.
TELEGRAM_AGENT_WEBHOOK_URL="https://telegram-agent.example.com/events"
TELEGRAM_AGENT_WEBHOOK_SECRET="change-this-to-a-different-long-random-secret"
